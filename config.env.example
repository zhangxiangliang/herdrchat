# herdrchat settings, the example of config.env. `herdrchat init` copies it to where the
# profile reads it (~/.config/herdrchat/default/config.env, ~/.config/herdrchat/<profile>/
# with --profile, or HERDRCHAT_HOME), private; then fill it in.

# the chat app this profile mirrors into: feishu (default) or telegram. To use both, run
# one profile each (herdrchat start --profile telegram).
HERDRCHAT_CHAT=feishu

# feishu
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_OWNER_OPEN_ID=

# telegram: the token from @BotFather (turn topic mode on there); your user id, which the
# bot tells you when you message it
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

HERDR_SESSIONS=session-a,session-b
# once /auth is done, spaces whose groups are muted (only an @ rings): `all` (default),
# empty for none, or spaces, comma-separated
HERDR_MUTED_SPACES=all
# spaces that do not even @-mention you (fully quiet): empty (default), `all`, or spaces
HERDR_SILENT_SPACES=
# the bot's tags next to group names (tenant tags): on (default) or off
HERDR_BOT_TAGS=on
# your sidebar labels, once /auth is done: on (default) or off
HERDR_USER_TAGS=on
# what a new room gets of the conversation before it: file,folded (default: all of it as a
# file, the newest part in a folded post), file, folded, or empty for nothing
HERDR_HISTORY=file,folded
