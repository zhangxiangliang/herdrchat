# herdrchat settings. `herdrchat init` copies this file to your profile's folder (only
# you can read it there). Fill in what is empty above the line, then run
# `herdrchat start`. Every setting is explained in docs/guide.md, "Settings".
# A key set in the environment wins over this file.

# Which chat app: feishu or telegram. To use both, run one profile each
# (`herdrchat init --profile telegram --chat telegram`).
HERDRCHAT_CHAT=feishu

# The hc sessions to mirror, comma-separated (machines they reach come along).
# `ls ~/.local/state/herdr-core` lists the sessions on this machine.
HERDR_SESSIONS=

# --- Feishu only ---
# From the Feishu developer console: your app's App ID and App Secret.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# You. Leave it empty: message the bot once and it tells you the line to put here.
FEISHU_OWNER_OPEN_ID=

# --- Telegram only ---
# The token @BotFather gave you (turn on Threaded Mode in BotFather's mini app too).
TELEGRAM_BOT_TOKEN=
# You. Leave it empty: message the bot once and it tells you the line to put here.
TELEGRAM_OWNER_ID=

# ------------------------------------------------------------------------------------
# The rest has good defaults; change it when you want to.

# Quiet spaces: only "needs you" and "done" make a sound there.
# Values: all (default), none (empty), or space names, comma-separated.
# Feishu does this once you send /auth to the bot; Telegram does it right away.
HERDR_MUTED_SPACES=all

# Fully silent spaces: nothing makes a sound there, not even "needs you".
# Values: none (empty, default), all, or space names, comma-separated.
HERDR_SILENT_SPACES=

# What a new group or topic gets of the conversation before it:
# file,folded (default: all of it as a file, its newest part in a folded post),
# file, folded, or empty for nothing. /history posts both whenever you ask.
HERDR_HISTORY=file,folded

# (Feishu only) The bot's tags next to group names: the session or machine, and "ended".
# They are visible to your whole Feishu team. on (default) or off.
HERDR_BOT_TAGS=on

# (Feishu only) Your own sidebar labels, once /auth is done. on (default) or off.
HERDR_USER_TAGS=on
